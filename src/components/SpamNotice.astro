---
// Shown only when JavaScript is off: the spam check needs JavaScript (ALTCHA and
// reCAPTCHA alike), so a post without it is rejected. Place above every form.
import { telHref } from '../lib/phone'
interface Props {
  /** Phone number as displayed, e.g. "063-12 34 56". */
  phone: string
  /** Optional tel: link when the display form can't be turned into one, e.g. "tel:+4663123456". */
  phoneHref?: string
  /** Optional e-mail address for the notice. */
  email?: string
}

const { phone, phoneHref, email } = Astro.props
const href = telHref(phone, phoneHref)
---

<noscript>
  <p class="spam-notice">
    Formuläret kräver JavaScript. Ring oss på <a href={href}>{phone}</a>{
      email && (
        <>
          {' '}eller mejla <a href={`mailto:${email}`}>{email}</a>
        </>
      )
    }.
  </p>
</noscript>
