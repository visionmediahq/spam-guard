---
// The reply to a form posted without JavaScript: the API route sends the browser back
// to this page with #skickat, #fel or #vanta (src/lib/form-redirect.ts), and the
// matching block shows through CSS :target. Place inside every <form>, next to
// <HoneypotField />. The form script hides the blocks when it sends (getSpamFields /
// addSpamToken) and again in spamSubmitted(), so a stale fragment never contradicts it.
import { telHref } from '../lib/phone'
import { FORM_STATUS_CLASS } from '../lib/spam-fields'
import { FORM_NAME, FORM_RETURN_FIELD, FORM_STATUS_FIELD } from '../lib/form-redirect'

interface Props {
  /** Phone number as displayed, e.g. "063-12 34 56". */
  phone: string
  /** Optional tel: link when the display form can't be turned into one, e.g. "tel:+4663123456". */
  phoneHref?: string
  /** Optional e-mail address for the error message. */
  email?: string
  /**
   * Only on a page with more than one form: a short name per form (lowercase letters,
   * digits, '-'), e.g. "offert". Its replies become #offert-skickat etc., so they show
   * at the form that was sent and the ids stay unique.
   */
  form?: string
}

const { phone, phoneHref, email, form } = Astro.props
// The server only accepts names like this; a mismatch would silently show nothing, so fail the build.
if (form !== undefined && !FORM_NAME.test(form)) {
  throw new Error(`<FormStatus form="${form}" />: use lowercase letters, digits and '-', e.g. "offert".`)
}
const href = telHref(phone, phoneHref)
const id = (result: string) => (form ? `${form}-${result}` : result)
// scroll-mt leaves room for a sticky header when the browser jumps to the fragment.
const block = `${FORM_STATUS_CLASS} alert hidden target:grid scroll-mt-40`
---

<input type="hidden" name={FORM_RETURN_FIELD} value={Astro.url.pathname} />
{form && <input type="hidden" name={FORM_STATUS_FIELD} value={form} />}
<p id={id('skickat')} class={`${block} alert-success`} role="status">Tack! Vi hör av oss så snart vi kan.</p>
<p id={id('fel')} class={`${block} alert-error`} role="alert">
  Meddelandet skickades inte. Ring oss på <a class="link font-semibold" href={href} onclick="window.umami?.track('phone_click')">{phone}</a>{email && <> eller mejla <a class="link font-semibold" href={`mailto:${email}`} onclick="window.umami?.track('email_click')">{email}</a></>}.
</p>
<p id={id('vanta')} class={`${block} alert-warning`} role="alert">
  Du har skickat flera meddelanden på kort tid. Vänta en stund, eller ring oss på
  <a class="link font-semibold" href={href} onclick="window.umami?.track('phone_click')">{phone}</a>.
</p>
